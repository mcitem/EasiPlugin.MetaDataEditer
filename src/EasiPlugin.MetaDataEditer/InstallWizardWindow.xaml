<!--
    安装向导窗口。

    注意：这里刻意不使用宿主的 SafeWindow 与宿主资源字典（Style.ShadowDialog /
    Brush.Text.Normal / Style.AccentButton），全部使用纯 WPF 与本地定义的样式。

    原因：安装向导运行在安装器启动的独立进程里，此时没有希沃白板宿主进程，
    插件的输出目录也不包含 Cvte.* 宿主程序集（宿主 DLL 只在编译期参与引用，
    运行时由宿主进程提供）。一旦碰任何宿主类型，独立进程就会抛
    FileNotFoundException: 无法加载 Cvte.Windows.cc，窗口根本显示不出来。
-->
<Window x:Class="Mcitem.EasiPlugin.MetaDataEditer.InstallWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540"
        Height="660"
        MinWidth="460"
        MinHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Title="{Binding TitleText}">

    <Window.Resources>
        <!-- 配色：纯白底 + 细边框 + 一个强调色，保持克制 -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E3E6EA" />
        <SolidColorBrush x:Key="TextNormalBrush" Color="#1F2328" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2B7FD4" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F6EBB" />

        <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}" />
        </Style>

        <Style x:Key="SectionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}" />
        </Style>

        <Style x:Key="TipTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextNormalBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调按钮：替代宿主的 Style.AccentButton -->
        <Style x:Key="AccentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource SurfaceBrush}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding TitleText}"
                       Style="{StaticResource TitleTextStyle}" />
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding SubtitleText}"
                       Style="{StaticResource TipTextStyle}" />
        </StackPanel>

        <!-- 内容 -->
        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <!-- 插件信息 -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding ProductNameText}"
                               Style="{StaticResource SectionTextStyle}" />
                    <TextBlock Margin="0,7,0,0"
                               Text="{Binding VersionText}" />
                    <TextBlock Margin="0,3,0,0"
                               Text="{Binding AuthorText}" />
                    <TextBlock Margin="0,8,0,0"
                               Text="{Binding DescriptionText}"
                               Style="{StaticResource TipTextStyle}" />
                </StackPanel>
            </Border>

            <!-- 宿主环境检测：安装向导最有价值的部分 -->
            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding HostCheckTitle}"
                               Style="{StaticResource SectionTextStyle}" />

                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding HostStatusLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HostStatusText}"
                                   TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding HostPathLabel}"
                                   Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding HostPathText}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 步骤清单 -->
            <Border Grid.Row="2"
                    Margin="0,12,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding StepsTitle}"
                               Style="{StaticResource SectionTextStyle}" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding StepItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,4"
                                           Text="{Binding}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2"
                    Margin="0,18,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Margin="0,0,8,0"
                    Content="{Binding CancelText}"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Content="{Binding PrimaryButtonText}"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    Click="OnPrimaryClick" />
        </StackPanel>
    </Grid>
</Window>
